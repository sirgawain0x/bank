import { NextRequest, NextResponse } from "next/server";
import { dinariClient } from "@/lib/dinari/client";

/**
 * GET /api/dinari/orders
 * List orders from Dinari
 */
export async function GET(request: NextRequest) {
  try {
    // List orders from Dinari
    const orders = await dinariClient.v2.listOrders();
    
    return NextResponse.json(orders);
  } catch (error: any) {
    console.error("Failed to list Dinari orders:", error.message);
    return NextResponse.json(
      { error: "Failed to list orders", details: error.message },
      { status: 500 }
    );
  }
}

/**
 * GET /api/dinari/orders/[id]
 * Get order details from Dinari (placeholder - actual method may not exist)
 */
export async function GET_BY_ID(request: NextRequest, { params }: { params: { id: string } }) {
  try {
    const { id } = params;
    
    if (!id) {
      return NextResponse.json(
        { error: "Order ID is required" },
        { status: 400 }
      );
    }
    
    // This is a placeholder - actual method may not exist
    // You would need to implement the actual order retrieval logic
    return NextResponse.json({
      id,
      message: "Order retrieval not implemented - check Dinari SDK documentation"
    });
  } catch (error: any) {
    console.error(`Failed to fetch Dinari order ${params.id}:`, error.message);
    return NextResponse.json(
      { error: "Failed to fetch order", details: error.message },
      { status: 500 }
    );
  }
}